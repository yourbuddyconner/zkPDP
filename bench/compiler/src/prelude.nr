// Library for circuits generated by cedar-to-noir. Not generated itself.
use sha256::{digest, sha256_var};

pub global MAX_TYPE: u32 = 24;
pub global MAX_ID: u32 = 48;
pub global MAX_ACTION: u32 = 32;
pub global MAX_NONCE: u32 = 32;
pub global MAX_UID: u32 = 76; // type, `::"`, id, `"`
pub global MAX_REQ: u32 = 384;
pub global MAX_ATTRS: u32 = 8;
pub global MAX_ANC: u32 = 16;
pub global MAX_SET: u32 = 8;
pub global MAX_DEPTH: u32 = 12;
pub global ZERO: [u8; 32] = [0; 32];

// One opened leaf of the entity commitment, merkle-sha256-record-v0.
pub struct Entity {
    pub uid_h: [u8; 32],
    pub present: u8, // bit i set when attribute i is present
    pub attrs: [[u8; 32]; MAX_ATTRS],
    pub ancestors: [[u8; 32]; MAX_ANC],
    pub path: [[u8; 32]; MAX_DEPTH],
    pub sibling_is_left: [bool; MAX_DEPTH],
    pub path_len: u32,
}

// One opened record-valued attribute.
pub struct Rec {
    pub present: u8,
    pub slots: [[u8; 32]; MAX_ATTRS],
}

pub fn zero_entity() -> Entity {
    Entity {
        uid_h: ZERO,
        present: 0,
        attrs: [ZERO; MAX_ATTRS],
        ancestors: [ZERO; MAX_ANC],
        path: [ZERO; MAX_DEPTH],
        sibling_is_left: [false; MAX_DEPTH],
        path_len: 0,
    }
}

pub fn zero_rec() -> Rec {
    Rec { present: 0, slots: [ZERO; MAX_ATTRS] }
}

pub fn eq_str<let N: u32, let M: u32>(s: BoundedVec<u8, N>, lit: str<M>) -> bool {
    let b = lit.as_bytes();
    let mut same = s.len() == M;
    for i in 0..M {
        same = same & (s.get_unchecked(i) == b[i]);
    }
    same
}

// Bytes that JSON and Cedar write without escaping, so the canonical request
// and the UID text can be rebuilt by concatenation.
pub fn assert_plain<let N: u32>(s: BoundedVec<u8, N>) {
    assert(s.len() <= N);
    for i in 0..N {
        let c = s.get_unchecked(i);
        let ok = (c >= 0x20) & (c < 0x7f) & (c != 0x22) & (c != 0x5c);
        assert(ok | (i >= s.len()));
        // Padding is zero, so one string has one encoding. E9 found this missing.
        assert((i < s.len()) | (c == 0));
    }
}

fn push_str<let N: u32, let M: u32>(buf: &mut BoundedVec<u8, N>, lit: str<M>) {
    buf.extend_from_array(lit.as_bytes());
}

// SHA-256 of `Type::"id"`.
pub fn uid_hash(ty: BoundedVec<u8, MAX_TYPE>, id: BoundedVec<u8, MAX_ID>) -> [u8; 32] {
    let mut buf: BoundedVec<u8, MAX_UID> = BoundedVec::new();
    buf.extend_from_bounded_vec(ty);
    push_str(&mut buf, "::\"");
    buf.extend_from_bounded_vec(id);
    push_str(&mut buf, "\"");
    sha256_var(buf.storage(), buf.len())
}

// SHA-256 of the canonical (JCS) AuthZEN request. The context is empty or
// holds only a nonce.
pub fn request_digest(
    subject_type: BoundedVec<u8, MAX_TYPE>,
    subject_id: BoundedVec<u8, MAX_ID>,
    action: BoundedVec<u8, MAX_ACTION>,
    resource_type: BoundedVec<u8, MAX_TYPE>,
    resource_id: BoundedVec<u8, MAX_ID>,
    nonce: BoundedVec<u8, MAX_NONCE>,
) -> [u8; 32] {
    let mut ctx: BoundedVec<u8, MAX_NONCE + 10> = BoundedVec::new();
    push_str(&mut ctx, "\"nonce\":\"");
    ctx.extend_from_bounded_vec(nonce);
    push_str(&mut ctx, "\"");
    if nonce.len() == 0 {
        ctx = BoundedVec::new();
    }
    let mut b: BoundedVec<u8, MAX_REQ> = BoundedVec::new();
    push_str(&mut b, "{\"action\":{\"name\":\"");
    b.extend_from_bounded_vec(action);
    push_str(&mut b, "\"},\"context\":{");
    b.extend_from_bounded_vec(ctx);
    push_str(&mut b, "},\"resource\":{\"id\":\"");
    b.extend_from_bounded_vec(resource_id);
    push_str(&mut b, "\",\"type\":\"");
    b.extend_from_bounded_vec(resource_type);
    push_str(&mut b, "\"},\"subject\":{\"id\":\"");
    b.extend_from_bounded_vec(subject_id);
    push_str(&mut b, "\",\"type\":\"");
    b.extend_from_bounded_vec(subject_type);
    push_str(&mut b, "\"}}");
    sha256_var(b.storage(), b.len())
}

pub fn rec_digest(present: u8, slots: [[u8; 32]; MAX_ATTRS]) -> [u8; 32] {
    let mut a: [u8; 1 + 32 * MAX_ATTRS] = [0; 1 + 32 * MAX_ATTRS];
    a[0] = present;
    for i in 0..MAX_ATTRS {
        for j in 0..32 {
            a[1 + 32 * i + j] = slots[i][j];
        }
    }
    digest(a)
}

pub fn set_digest<let N: u32>(set: [[u8; 32]; N]) -> [u8; 32] {
    let mut c: [u8; 32 * N] = [0; 32 * N];
    for i in 0..N {
        for j in 0..32 {
            c[32 * i + j] = set[i][j];
        }
    }
    digest(c)
}

fn leaf_hash(e: Entity) -> [u8; 32] {
    let ah = rec_digest(e.present, e.attrs);
    let ch = set_digest(e.ancestors);
    let mut l: [u8; 96] = [0; 96];
    for j in 0..32 {
        l[j] = e.uid_h[j];
        l[32 + j] = ah[j];
        l[64 + j] = ch[j];
    }
    digest(l)
}

// True when the entity is a leaf of the tree with this root.
pub fn opens(e: Entity, root: [u8; 32]) -> bool {
    let mut h = leaf_hash(e);
    for i in 0..MAX_DEPTH {
        let mut node: [u8; 65] = [0; 65];
        node[0] = 1;
        for j in 0..32 {
            node[1 + j] = if e.sibling_is_left[i] { e.path[i][j] } else { h[j] };
            node[33 + j] = if e.sibling_is_left[i] { h[j] } else { e.path[i][j] };
        }
        let up = digest(node);
        if i < e.path_len {
            h = up;
        }
    }
    (h == root) & (e.path_len <= MAX_DEPTH)
}

pub fn in_set<let N: u32>(set: [[u8; 32]; N], x: [u8; 32]) -> bool {
    let mut found = false;
    for i in 0..N {
        found = found | (set[i] == x);
    }
    found
}

// True when the two sets share an element. Zero slots are padding.
pub fn intersects<let N: u32, let M: u32>(a: [[u8; 32]; N], b: [[u8; 32]; M]) -> bool {
    let mut found = false;
    for i in 0..N {
        found = found | ((a[i] != ZERO) & in_set(b, a[i]));
    }
    found
}

pub fn subset<let N: u32, let M: u32>(a: [[u8; 32]; N], b: [[u8; 32]; M]) -> bool {
    let mut all = true;
    for i in 0..N {
        all = all & ((a[i] == ZERO) | in_set(b, a[i]));
    }
    all
}

pub fn bit(present: u8, i: u8) -> bool {
    ((present >> i) & 1) == 1
}

// A Cedar Long from its slot: the low 8 bytes, big-endian, two's complement.
pub fn be_u64(slot: [u8; 32]) -> u64 {
    let mut v: u64 = 0;
    for i in 0..8 {
        v = v * 256 + (slot[24 + i] as u64);
    }
    v
}

global SIGN: u64 = 0x8000000000000000;

pub fn slt(a: u64, b: u64) -> bool {
    (a ^ SIGN) < (b ^ SIGN)
}

pub fn sle(a: u64, b: u64) -> bool {
    (a ^ SIGN) <= (b ^ SIGN)
}
