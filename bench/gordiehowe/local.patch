diff --git a/lib/gordiehowe/CMakeLists.txt b/lib/gordiehowe/CMakeLists.txt
index 9b9b0f6..bdbb246 100644
--- a/lib/gordiehowe/CMakeLists.txt
+++ b/lib/gordiehowe/CMakeLists.txt
@@ -55,7 +55,7 @@ add_library(gordiehowe_compiler_digest STATIC ${GORDIEHOWE_COMPILER_DIGEST})
 # definitions, which a reused precompiled header requires.
 add_library(gordiehowe_pch STATIC pch.cc)
 macro(gordiehowe_use_pch TARGET)
-  target_link_libraries(${TARGET} gtest benchmark::benchmark
+  target_link_libraries(${TARGET}
                         gordiehowe_compiler_digest)
   if(NOT "${TARGET}" STREQUAL "gordiehowe_pch")
     target_precompile_headers(${TARGET} REUSE_FROM gordiehowe_pch)
@@ -66,8 +66,7 @@ target_precompile_headers(gordiehowe_pch PRIVATE
                           <gordiehowe/instances.h>
                           <algebra/reed_solomon_fp.h>
                           <params/param_sets.h>
-                          <random/secure_random_engine.h>
-                          <gtest/gtest.h>)
+                          <random/secure_random_engine.h>)
 if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
   # Without timestamps ccache can hash the precompiled header.
   target_compile_options(gordiehowe_pch PRIVATE -Xclang -fno-pch-timestamp)
@@ -161,3 +160,14 @@ add_subdirectory(tests)
 add_subdirectory(examples)
 add_subdirectory(bench/hash_comparisons)
 add_subdirectory(heldout)
+
+# zk-pdp local drivers, not upstream.
+add_executable(zkpdp_hello $ENV{HOME}/code/zk-pdp/bench/gordiehowe/hello.cc)
+target_link_libraries(zkpdp_hello gordiehowe_instances_gf128_sha256 gordiehowe_compiler_digest flatsha ec algebra util pthread OpenSSL::Crypto)
+add_executable(zkpdp_tinytodo $ENV{HOME}/code/zk-pdp/bench/gordiehowe/tinytodo.cc)
+target_link_libraries(zkpdp_tinytodo gordiehowe_instances_gf128_sha256 gordiehowe_compiler_digest flatsha ec algebra util pthread OpenSSL::Crypto)
+add_executable(zkpdp_tinytodo_signed $ENV{HOME}/code/zk-pdp/bench/gordiehowe/tinytodo.cc)
+target_compile_definitions(zkpdp_tinytodo_signed PRIVATE ZKPDP_SIGNED=1)
+target_link_libraries(zkpdp_tinytodo_signed gordiehowe_instances_mdoc gordiehowe_compiler_digest flatsha ec algebra util pthread OpenSSL::Crypto)
+add_executable(zkpdp_policy $ENV{HOME}/code/zk-pdp/bench/gordiehowe/policy.cc)
+target_link_libraries(zkpdp_policy gordiehowe_instances_gf128_sha256 gordiehowe_compiler_digest flatsha ec algebra util pthread OpenSSL::Crypto)
diff --git a/lib/gordiehowe/compiler/program_printer.h b/lib/gordiehowe/compiler/program_printer.h
index e4dc5e1..b0f692f 100644
--- a/lib/gordiehowe/compiler/program_printer.h
+++ b/lib/gordiehowe/compiler/program_printer.h
@@ -874,7 +874,8 @@ namespace program_printer_internal {
 
 // The natural holding the W-bit entries XS, entry i at bits [W i, W (i+1)),
 // in decimal.
-inline std::string packed_decimal(const std::vector<uint64_t> &xs, size_t w) {
+template <class Int>
+inline std::string packed_decimal(const std::vector<Int> &xs, size_t w) {
   std::vector<bool> bits(xs.size() * w, false);
   for (size_t i = 0; i < xs.size(); ++i)
     for (size_t b = 0; b < w; ++b) bits[i * w + b] = (xs[i] >> b) & 1;
